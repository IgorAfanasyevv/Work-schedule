# Copy this file to .env.local (which is git-ignored) and fill in your real values
# from your Supabase project: Project Settings -> API.
#
# If these are left unset, the app falls back to localStorage automatically
# (each browser gets its own independent copy of the data — fine for local dev,
# but visitors won't share the same schedule).

VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
